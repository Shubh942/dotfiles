diff --git a/src/app/api/sub_agents.rs b/src/app/api/sub_agents.rs
new file mode 100644
index 00000000..d97bde7e
--- /dev/null
+++ b/src/app/api/sub_agents.rs
@@ -0,0 +1,230 @@
+use crate::api::schema::{
+    PaneReleaseSubAgentParams, PaneReportSubAgentParams, PaneTarget, ResponseResult,
+};
+use crate::app::App;
+
+use super::super::api_helpers::{
+    detect_state_from_api, normalize_metadata_source, normalize_reported_agent_label,
+};
+use super::responses::{encode_error, encode_success};
+
+/// Sub-agent slots are short identifiers chosen by the reporter.
+const SUB_AGENT_SLOT_MAX_CHARS: usize = 64;
+const SUB_AGENTS_PER_PANE_MAX: usize = 32;
+
+fn valid_slot(slot: &str) -> bool {
+    !slot.is_empty()
+        && slot.chars().count() <= SUB_AGENT_SLOT_MAX_CHARS
+        && !slot.contains(crate::terminal::SUB_AGENT_TARGET_SEPARATOR_CHAR)
+        && !slot.chars().any(char::is_control)
+}
+
+fn presentation_text(value: Option<String>) -> Option<String> {
+    value
+        .map(|value| value.trim().to_string())
+        .filter(|value| !value.is_empty())
+}
+
+impl App {
+    pub(super) fn handle_pane_report_sub_agent(
+        &mut self,
+        id: String,
+        params: PaneReportSubAgentParams,
+    ) -> String {
+        let Some((ws_idx, pane_id)) = self.parse_pane_id(&params.pane_id) else {
+            return super::panes::pane_not_found(id, &params.pane_id);
+        };
+        if !valid_slot(&params.slot) {
+            return encode_error(id, "invalid_slot", "invalid sub-agent slot");
+        }
+        let Some(agent_label) = normalize_reported_agent_label(&params.agent) else {
+            return encode_error(id, "invalid_agent", "invalid agent label");
+        };
+        let source = match normalize_metadata_source(params.source) {
+            Ok(source) => source,
+            Err(message) => return encode_error(id, "invalid_source", message),
+        };
+        if params
+            .focus_argv
+            .as_ref()
+            .is_some_and(|argv| argv.is_empty() || argv.len() > 64)
+        {
+            return encode_error(
+                id,
+                "invalid_focus_argv",
+                "focus_argv must have 1-64 arguments",
+            );
+        }
+        if let Some(Err(message)) = params
+            .pane_resume_argv
+            .as_deref()
+            .map(crate::agent_resume::validate_resume_argv)
+        {
+            return encode_error(id, "invalid_pane_resume_argv", message);
+        }
+        let Some(terminal_id) = self
+            .state
+            .workspaces
+            .get(ws_idx)
+            .and_then(|workspace| workspace.pane_state(pane_id))
+            .map(|pane| pane.attached_terminal_id.clone())
+        else {
+            return super::panes::pane_not_found(id, &params.pane_id);
+        };
+        let pane_resume = params.pane_resume_argv.map(|argv| crate::agent_resume::ReportedAgentResume {
+            source: source.clone(),
+            agent: agent_label.clone(),
+            argv,
+        });
+        let next_seq = &mut self.state.next_agent_state_change_seq;
+        let Some(terminal) = self.state.terminals.get_mut(&terminal_id) else {
+            return super::panes::pane_not_found(id, &params.pane_id);
+        };
+        if !terminal.sub_agents().contains_key(&params.slot)
+            && terminal.sub_agents().len() >= SUB_AGENTS_PER_PANE_MAX
+        {
+            return encode_error(id, "sub_agent_limit", "too many sub-agents in this pane");
+        }
+        let focused = params.focused;
+        let mut changed = terminal.report_sub_agent(
+            &params.slot,
+            crate::terminal::SubAgentReport {
+                source,
+                agent_label,
+                state: detect_state_from_api(params.state),
+                title: presentation_text(params.title),
+                display_agent: presentation_text(params.display_agent),
+                focus_argv: params.focus_argv,
+                seq: params.seq,
+            },
+            || {
+                *next_seq += 1;
+                *next_seq
+            },
+        );
+        let mut resume_changed = false;
+        if let Some(resume) = pane_resume {
+            if terminal.reported_resume() != Some(&resume) {
+                terminal.restore_reported_resume(resume);
+                resume_changed = true;
+            }
+        }
+        if focused && terminal.focused_sub_agent() != Some(params.slot.as_str()) {
+            changed |= terminal.focus_sub_agent(&params.slot).is_some();
+        }
+        if resume_changed {
+            self.state.mark_session_dirty();
+            self.schedule_session_save();
+        }
+        if changed {
+            self.render_dirty.request_generic();
+            self.render_notify.notify_one();
+        }
+        encode_success(id, ResponseResult::Ok {})
+    }
+
+    pub(super) fn handle_pane_release_sub_agent(
+        &mut self,
+        id: String,
+        params: PaneReleaseSubAgentParams,
+    ) -> String {
+        let Some((ws_idx, pane_id)) = self.parse_pane_id(&params.pane_id) else {
+            return super::panes::pane_not_found(id, &params.pane_id);
+        };
+        let Some(terminal_id) = self
+            .state
+            .workspaces
+            .get(ws_idx)
+            .and_then(|workspace| workspace.pane_state(pane_id))
+            .map(|pane| pane.attached_terminal_id.clone())
+        else {
+            return super::panes::pane_not_found(id, &params.pane_id);
+        };
+        let released = self
+            .state
+            .terminals
+            .get_mut(&terminal_id)
+            .is_some_and(|terminal| terminal.release_sub_agent(&params.slot, params.seq));
+        if released {
+            self.render_dirty.request_generic();
+            self.render_notify.notify_one();
+        }
+        encode_success(id, ResponseResult::Ok {})
+    }
+
+    /// Focuses `pane#slot`: focuses the pane, then runs the slot's focus command.
+    pub(super) fn handle_sub_agent_focus(
+        &mut self,
+        id: String,
+        pane_id: &str,
+        slot: &str,
+    ) -> String {
+        let response = self.handle_pane_focus(
+            id,
+            PaneTarget {
+                pane_id: pane_id.to_string(),
+            },
+        );
+        let Some((ws_idx, pane)) = self.parse_pane_id(pane_id) else {
+            return response;
+        };
+        let Some(terminal_id) = self
+            .state
+            .workspaces
+            .get(ws_idx)
+            .and_then(|workspace| workspace.pane_state(pane))
+            .map(|pane| pane.attached_terminal_id.clone())
+        else {
+            return response;
+        };
+        let focus_argv = self
+            .state
+            .terminals
+            .get_mut(&terminal_id)
+            .and_then(|terminal| terminal.focus_sub_agent(slot));
+        if let Some(argv) = focus_argv {
+            self.render_dirty.request_generic();
+            self.render_notify.notify_one();
+            if let Some(argv) = argv {
+                spawn_focus_command(argv);
+            }
+        }
+        response
+    }
+}
+
+fn spawn_focus_command(argv: Vec<String>) {
+    let Some((program, args)) = argv.split_first() else {
+        return;
+    };
+    let spawned = std::process::Command::new(program)
+        .args(args)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn();
+    match spawned {
+        // Reap the child off-thread so it does not linger as a zombie.
+        Ok(mut child) => {
+            std::thread::spawn(move || {
+                let _ = child.wait();
+            });
+        }
+        Err(error) => tracing::warn!(%error, program, "sub-agent focus command failed"),
+    }
+}
