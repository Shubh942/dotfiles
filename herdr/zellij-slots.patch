+fn pane_report_sub_agent(args: &[String]) -> std::io::Result<i32> {
+    const USAGE: &str = "usage: herdr pane report-sub-agent <pane_id> --slot ID --source ID --agent LABEL --state idle|working|blocked|unknown [--title TEXT] [--display-agent TEXT] [--seq N] [--focused] [--pane-resume CMD] [-- <focus-command...>]";
+
+    let (args, focus_argv) = split_resume_argv(args);
+    let focused = args.iter().any(|arg| arg == "--focused");
+    let args: Vec<String> = args.iter().filter(|arg| *arg != "--focused").cloned().collect();
+    let args = super::expand_equals_args(
+        &args,
+        &[
+            "--slot",
+            "--source",
+            "--agent",
+            "--state",
+            "--title",
+            "--display-agent",
+            "--seq",
+            "--pane-resume",
+        ],
+    );
+    let mut pane_id = None;
+    let mut values: std::collections::HashMap<&str, String> = std::collections::HashMap::new();
+    let mut index = 0;
+    while index < args.len() {
+        let arg = args[index].as_str();
+        match arg {
+            "--slot" | "--source" | "--agent" | "--state" | "--title" | "--display-agent"
+            | "--seq" | "--pane-resume" => {
+                let Some(value) = args.get(index + 1) else {
+                    eprintln!("missing value for {arg}");
+                    return Ok(2);
+                };
+                values.insert(arg, value.clone());
+                index += 2;
+            }
+            option if option.starts_with('-') => {
+                eprintln!("unknown option: {option}");
+                return Ok(2);
+            }
+            positional => {
+                if pane_id.is_some() {
+                    eprintln!("unexpected argument: {positional}");
+                    return Ok(2);
+                }
+                pane_id = Some(super::normalize_pane_id(positional));
+                index += 1;
+            }
+        }
+    }
+    let Some(pane_id) = pane_id else {
+        eprintln!("{USAGE}");
+        return Ok(2);
+    };
+    for required in ["--slot", "--source", "--agent", "--state"] {
+        if values
+            .get(required)
+            .is_none_or(|value| value.trim().is_empty())
+        {
+            eprintln!("missing required {required}");
+            return Ok(2);
+        }
+    }
+    let state = super::parse_pane_agent_state(&values["--state"])?;
+    let seq = match values.get("--seq") {
+        Some(value) => Some(super::parse_u64_flag("--seq", value)?),
+        None => None,
+    };
+    super::send_ok_request(Method::PaneReportSubAgent(PaneReportSubAgentParams {
+        pane_id,
+        slot: values["--slot"].clone(),
+        source: values["--source"].trim().to_string(),
+        agent: values["--agent"].clone(),
+        state,
+        title: values.get("--title").cloned(),
+        display_agent: values.get("--display-agent").cloned(),
+        seq,
+        focus_argv,
+        focused,
+        pane_resume_argv: values
+            .get("--pane-resume")
+            .map(|cmd| cmd.split_whitespace().map(str::to_string).collect()),
+    }))
+}
+
+fn pane_release_sub_agent(args: &[String]) -> std::io::Result<i32> {
+    const USAGE: &str = "usage: herdr pane release-sub-agent <pane_id> --slot ID [--seq N]";
+    let args = super::expand_equals_args(args, &["--slot", "--seq"]);
+    let mut pane_id = None;
+    let mut slot = None;
+    let mut seq = None;
+    let mut index = 0;
+    while index < args.len() {
+        let arg = args[index].as_str();
+        match arg {
+            "--slot" | "--seq" => {
+                let Some(value) = args.get(index + 1) else {
+                    eprintln!("missing value for {arg}");
+                    return Ok(2);
+                };
+                if arg == "--slot" {
+                    slot = Some(value.clone());
+                } else {
+                    seq = Some(super::parse_u64_flag("--seq", value)?);
+                }
+                index += 2;
+            }
+            option if option.starts_with('-') => {
+                eprintln!("unknown option: {option}");
+                return Ok(2);
+            }
+            positional => {
+                if pane_id.is_some() {
+                    eprintln!("unexpected argument: {positional}");
+                    return Ok(2);
+                }
+                pane_id = Some(super::normalize_pane_id(positional));
+                index += 1;
+            }
+        }
+    }
+    let (Some(pane_id), Some(slot)) = (pane_id, slot) else {
+        eprintln!("{USAGE}");
+        return Ok(2);
+    };
+    super::send_ok_request(Method::PaneReleaseSubAgent(PaneReleaseSubAgentParams {
+        pane_id,
+        slot,
+        seq,
+    }))
+}
