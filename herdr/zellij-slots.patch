+/// Reports one of several agents that live inside a single pane, such as agents
+/// running in the panes of a terminal multiplexer nested in a Herdr pane. Each
+/// slot is listed as its own agent.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+pub struct PaneReportSubAgentParams {
+    pub pane_id: String,
+    pub slot: String,
+    pub source: String,
+    pub agent: String,
+    pub state: PaneAgentState,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub title: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub display_agent: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub seq: Option<u64>,
+    /// Command run (without a shell) when the slot is focused, for example to
+    /// switch the nested multiplexer to that agent.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub focus_argv: Option<Vec<String>>,
+    /// Marks the slot focused without running its focus command, for when the
+    /// nested multiplexer itself switched to that agent.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub focused: bool,
+    /// Command the restored pane runs after a Herdr restart, for example to
+    /// rebuild the nested multiplexer with its agents resumed.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub pane_resume_argv: Option<Vec<String>>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+pub struct PaneReleaseSubAgentParams {
+    pub pane_id: String,
+    pub slot: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub seq: Option<u64>,
+}
