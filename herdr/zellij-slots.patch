+use std::collections::BTreeMap;
+
+use crate::detect::AgentState;
+
+use super::TerminalState;
+
+/// One of several agents reported inside a single terminal, for example agents
+/// running in the panes of a terminal multiplexer nested in a Herdr pane.
+///
+/// Sub-agents are reported state only: they never take part in screen
+/// detection, hook authority, or session restore of the terminal itself.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SubAgent {
+    pub source: String,
+    pub agent_label: String,
+    pub state: AgentState,
+    pub title: Option<String>,
+    pub display_agent: Option<String>,
+    pub focus_argv: Option<Vec<String>>,
+    pub seq: Option<u64>,
+    pub state_change_seq: u64,
+    /// False after the agent finished a turn until its slot is focused.
+    pub seen: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SubAgentReport {
+    pub source: String,
+    pub agent_label: String,
+    pub state: AgentState,
+    pub title: Option<String>,
+    pub display_agent: Option<String>,
+    pub focus_argv: Option<Vec<String>>,
+    pub seq: Option<u64>,
+}
+
+/// Separator between a pane id and a sub-agent slot in agent target ids.
+pub const SUB_AGENT_TARGET_SEPARATOR_CHAR: char = '#';
+
+pub fn sub_agent_target_id(pane_id: &str, slot: &str) -> String {
+    format!("{pane_id}{SUB_AGENT_TARGET_SEPARATOR_CHAR}{slot}")
+}
+
+/// Splits `w1:p2#slot` into (`w1:p2`, `slot`).
+pub fn split_sub_agent_target_id(target: &str) -> Option<(&str, &str)> {
+    let (pane_id, slot) = target.split_once(SUB_AGENT_TARGET_SEPARATOR_CHAR)?;
+    (!pane_id.is_empty() && !slot.is_empty()).then_some((pane_id, slot))
+}
+
+impl TerminalState {
+    pub fn sub_agents(&self) -> &BTreeMap<String, SubAgent> {
+        &self.sub_agents
+    }
+
+    /// Applies a sub-agent report. Returns true when anything changed.
+    /// `next_state_change_seq` is called only when the reported state changes.
+    pub fn report_sub_agent(
+        &mut self,
+        slot: &str,
+        report: SubAgentReport,
+        next_state_change_seq: impl FnOnce() -> u64,
+    ) -> bool {
+        if let Some(existing) = self.sub_agents.get(slot) {
+            if let (Some(previous), Some(incoming)) = (existing.seq, report.seq) {
+                if incoming <= previous {
+                    return false;
+                }
+            }
+        }
+        let previous = self.sub_agents.get(slot);
+        let state_changed = previous.is_none_or(|previous| previous.state != report.state);
+        let finished_turn = previous.is_some_and(|previous| {
+            previous.state == AgentState::Working && report.state == AgentState::Idle
+        });
+        let state_change_seq = if state_changed {
+            next_state_change_seq()
+        } else {
+            previous.map_or(0, |previous| previous.state_change_seq)
+        };
+        let seen = if finished_turn {
+            false
+        } else {
+            previous.is_none_or(|previous| previous.seen)
+        };
+        let updated = SubAgent {
+            source: report.source,
+            agent_label: report.agent_label,
+            state: report.state,
+            title: report
+                .title
+                .or_else(|| previous.and_then(|p| p.title.clone())),
+            display_agent: report
+                .display_agent
+                .or_else(|| previous.and_then(|p| p.display_agent.clone())),
+            focus_argv: report
+                .focus_argv
+                .or_else(|| previous.and_then(|p| p.focus_argv.clone())),
+            seq: report.seq,
+            state_change_seq,
+            seen,
+        };
+        if previous == Some(&updated) {
+            return false;
+        }
+        self.sub_agents.insert(slot.to_string(), updated);
+        true
+    }
+
+    pub fn release_sub_agent(&mut self, slot: &str, seq: Option<u64>) -> bool {
+        let Some(existing) = self.sub_agents.get(slot) else {
+            return false;
+        };
+        if let (Some(previous), Some(incoming)) = (existing.seq, seq) {
+            if incoming <= previous {
+                return false;
+            }
+        }
+        self.sub_agents.remove(slot).is_some()
+    }
+
+    /// Marks a slot focused; returns its focus command, if any.
+    pub fn focus_sub_agent(&mut self, slot: &str) -> Option<Option<Vec<String>>> {
+        let agent = self.sub_agents.get_mut(slot)?;
+        agent.seen = true;
+        self.focused_sub_agent = Some(slot.to_string());
+        Some(agent.focus_argv.clone())
+    }
+
+    /// The terminal's own state plus each sub-agent's, for attention rollups.
+    pub fn attention_states(
+        &self,
+        pane_seen: bool,
+    ) -> impl Iterator<Item = (AgentState, bool)> + '_ {
+        std::iter::once((self.state, pane_seen)).chain(
+            self.sub_agents
+                .values()
+                .map(|agent| (agent.state, agent.seen)),
+        )
+    }
+
+    pub fn focused_sub_agent(&self) -> Option<&str> {
+        self.focused_sub_agent
+            .as_deref()
+            .filter(|slot| self.sub_agents.contains_key(*slot))
+    }
+}
+
