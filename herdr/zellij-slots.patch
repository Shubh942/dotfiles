+        let target = sub_agent_target_id("w1:p2", "3");
+        assert_eq!(target, "w1:p2#3");
+        assert_eq!(split_sub_agent_target_id(&target), Some(("w1:p2", "3")));
+        assert_eq!(split_sub_agent_target_id("w1:p2"), None);
+        assert_eq!(split_sub_agent_target_id("w1:p2#"), None);
+    }
+
+    #[test]
+    fn stale_reports_are_ignored() {
+        let mut terminal = terminal();
+        assert!(terminal.report_sub_agent("a", report(AgentState::Working, 5), || 1));
+        assert!(!terminal.report_sub_agent("a", report(AgentState::Idle, 4), || 2));
+        assert_eq!(terminal.sub_agents()["a"].state, AgentState::Working);
+        assert!(!terminal.release_sub_agent("a", Some(5)));
+        assert!(terminal.release_sub_agent("a", Some(6)));
+        assert!(terminal.sub_agents().is_empty());
+    }
+
+    #[test]
+    fn slots_are_independent_and_keep_presentation() {
+        let mut terminal = terminal();
+        let mut named = report(AgentState::Idle, 1);
+        named.display_agent = Some("fortigate".into());
+        named.focus_argv = Some(vec!["true".into()]);
+        terminal.report_sub_agent("a", named, || 1);
+        terminal.report_sub_agent("b", report(AgentState::Blocked, 1), || 2);
+        terminal.report_sub_agent("a", report(AgentState::Working, 2), || 3);
+        let a = &terminal.sub_agents()["a"];
+        assert_eq!(a.display_agent.as_deref(), Some("fortigate"));
+        assert_eq!(a.state_change_seq, 3);
+        assert_eq!(terminal.sub_agents()["b"].state, AgentState::Blocked);
+        assert_eq!(
+            terminal.focus_sub_agent("a"),
+            Some(Some(vec!["true".to_string()]))
+        );
+        assert_eq!(terminal.focused_sub_agent(), Some("a"));
+        assert_eq!(terminal.focus_sub_agent("missing"), None);
+    }
+
+    #[test]
+    fn finished_turn_is_unseen_until_focused() {
+        let mut terminal = terminal();
+        terminal.report_sub_agent("a", report(AgentState::Working, 1), || 1);
+        assert!(terminal.sub_agents()["a"].seen);
+        terminal.report_sub_agent("a", report(AgentState::Idle, 2), || 2);
+        assert!(!terminal.sub_agents()["a"].seen);
+        terminal.focus_sub_agent("a");
+        assert!(terminal.sub_agents()["a"].seen);
+    }
+}
